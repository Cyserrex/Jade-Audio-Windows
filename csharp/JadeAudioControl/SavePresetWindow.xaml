<Window x:Class="JadeAudioControl.SavePresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save to your account"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        ResizeMode="NoResize" UseLayoutRounding="True">

    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="#2A303A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="36" Background="Transparent" MouseLeftButtonDown="Drag">
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="26,0,26,24">
                <TextBlock Text="Save to your account" Style="{StaticResource Display}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Margin="0,4,0,18" />

                <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}" MaxLength="60" />

                <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,14,0,5" />
                <TextBox x:Name="DescriptionBox" Style="{StaticResource ModernTextBox}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="72"
                         VerticalScrollBarVisibility="Auto" MaxLength="300" />
                <TextBlock Text="What it is for - the headphone, the genre, what you changed."
                           Style="{StaticResource Caption}" Margin="0,5,0,0" />

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ShareBox" Style="{StaticResource ModernCheck}"
                                  Content="Also share it publicly" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="25,5,0,0"
                                   Text="Anyone browsing Handpick for this device will see it, along with your FiiO display name. Leave it off to keep the preset to yourself." />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}"
                           Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Save"
                            Click="Save_Click" Width="110" />
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" Margin="8,0,0,0"
                            Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
